# Server-side configuration for the backend-for-frontend (see src/lib/api/config.ts).
# NOTHING here is prefixed NEXT_PUBLIC_: none of it may reach browser code.
# In production every value below marked REQUIRED must be set; the server refuses to serve auth requests otherwise (fail closed).
# Do not copy example values into production: they are local-development conventions only.

# Base URL of the Express API INCLUDING its version path. REQUIRED in production (https unless API_ALLOW_INSECURE_HTTP=true).
# Local development defaults to http://localhost:4000/api/v1 when unset.
API_BASE_URL=http://localhost:4000/api/v1

# Production only: set to true ONLY for a private-network hop where TLS is terminated elsewhere. Leave unset otherwise.
# API_ALLOW_INSECURE_HTTP=true

# Timeout for each API call in milliseconds (500-60000, default 10000).
# API_TIMEOUT_MS=10000

# Name of the session cookie as the API sets it (must match the API's SESSION_COOKIE_NAME). Default ioh_session.
# API_SESSION_COOKIE_NAME=ioh_session

# Exact public origin(s) of THIS app, comma separated, for checking custom state-changing route handlers. REQUIRED in production (https).
# Development defaults to http://localhost:3000 and http://127.0.0.1:3000 when unset.
# APP_ORIGIN=https://app.example.com

# Number of trusted reverse proxies in FRONT of this server (0-5). REQUIRED in production: state it explicitly (0 means none).
# The API's TRUST_PROXY must be set to the matching number of hops between the API and the real client. Both are deployment facts.
# TRUSTED_PROXY_HOPS=0
